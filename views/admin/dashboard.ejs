function resetPostForm() {
  document.getElementById('post-form-title').textContent = '➕ Add Blog Post';
  document.getElementById('postForm').reset();
  document.getElementById('postForm').action = '/admin/blog/add';
  document.getElementById('postSubmitBtn').textContent = '➕ Publish Post';
  showTab('blog');
}
</script>

