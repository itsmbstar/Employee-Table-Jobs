<%- include('../partials/header') %>
<main class="container section">
  <h1>My Profile</h1>
  <div class="profile-grid">
    <div class="profile-card">
      <h2>Account Details</h2>
      <p><strong>Name:</strong> <%= fullUser.name %></p>
      <p><strong>Email:</strong> <%= fullUser.email %></p>
      <p><strong>City:</strong> <%= fullUser.city||'Not set' %></p>
      <p><strong>Member since:</strong> <%= timeAgo(fullUser.createdAt) %></p>
      <a href="/logout" class="btn btn-outline" style="margin-top:1rem">Logout</a>
    </div>
    <div class="profile-card">
      <h2>Saved Jobs (<%= savedJobs.length %>)</h2>
      <% if(savedJobs.length===0){ %>
        <p class="text-muted">No saved jobs yet. Click "Save Job" on any listing.</p>
        <a href="/" class="btn btn-primary" style="margin-top:1rem">Browse Jobs</a>
      <% }else{ %>
        <div class="saved-jobs-list">
          <% savedJobs.forEach(job=>{ %>
            <a href="/job/<%= job.slug %>" class="saved-job-item">
              <strong><%= job.jobRole %></strong>
              <span><%= job.companyName %> · <%= job.workLocation %></span>
            </a>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>
</main>
<%- include('../partials/footer') %>
