<%- include('../partials/header') %>
<main class="container section">
  <div class="auth-card">
    <h1>Create Your Free Account</h1>
    <p class="text-muted">Already registered? <a href="/login">Login here</a></p>
    <form method="POST" action="/signup" class="auth-form">
      <div class="form-group"><label for="name">Full Name</label><input type="text" id="name" name="name" required placeholder="Your full name" class="form-input"></div>
      <div class="form-group"><label for="email">Email Address</label><input type="email" id="email" name="email" required placeholder="you@example.com" class="form-input"></div>
      <div class="form-group"><label for="password">Password</label><input type="password" id="password" name="password" required placeholder="Min 6 characters" minlength="6" class="form-input"></div>
      <div class="form-group"><label for="city">Preferred City</label>
        <select id="city" name="city" class="form-input">
          <option value="">Select city</option>
          <% cities.forEach(c=>{ %><option value="<%= c.name %>"><%= c.name %></option><% }) %>
        </select>
      </div>
      <button type="submit" class="btn btn-primary btn-full">Create Free Account</button>
    </form>
  </div>
</main>
<%- include('../partials/footer') %>
