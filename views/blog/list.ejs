<%- include('../partials/header') %>
<section class="hero hero-sm">
  <div class="container hero-inner">
    <h1>Career Blog</h1>
    <p class="hero-sub">Resume tips, interview guides, and job market insights — free resources for freshers across India.</p>
  </div>
</section>
<main class="container section">
  <h2>Latest Articles</h2>
  <% if(posts.length===0){ %>
    <div class="empty-state"><p>No articles yet. Check back soon!</p></div>
  <% }else{ %>
    <div class="blog-grid">
      <% posts.forEach(post=>{ %>
        <article class="blog-card" itemscope itemtype="https://schema.org/BlogPosting">
          <% if(post.coverImage){ %>
            <a href="/blog/<%= post.slug %>"><img src="<%= post.coverImage %>" alt="<%= post.title %>" class="blog-cover" width="400" height="200" loading="lazy" itemprop="image"></a>
          <% } %>
          <div class="blog-card-body">
            <a href="/blog/<%= post.slug %>"><h3 itemprop="headline"><%= post.title %></h3></a>
            <p class="blog-excerpt" itemprop="description"><%= post.excerpt %></p>
            <div class="blog-meta">
              <time itemprop="datePublished" datetime="<%= new Date(post.timestamp).toISOString() %>">📅 <%= timeAgo(post.timestamp) %></time>
              <a href="/blog/<%= post.slug %>" class="btn btn-outline btn-sm">Read more →</a>
            </div>
          </div>
        </article>
      <% }) %>
    </div>
  <% } %>
</main>
<%- include('../partials/footer') %>
