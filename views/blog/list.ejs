<%- include('../partials/header') %>
<section class="hero hero-sm">
  <div class="container hero-inner">
    <h1>Career Blog</h1>
    <p class="hero-sub">Resume tips, interview guides, and job market insights — free resources for freshers across India.</p>
  </div>
</section>
<main class="container section">
  <h2>Latest Articles</h2>
  <% if(posts.length===0){ %>
    <div class="empty-state"><p>No articles yet. Check back soon!</p></div>
  <% }else{ %>
    <div class="blog-grid">
      <% posts.forEach(post=>{ %>
        <div style="margin-bottom: 10px;">
  <a href="/blog/<%= post.slug %>"><h2><%= post.title %></h2></a>
  <p><%= post.excerpt || post.content.substring(0, 150) %>...</p>
  <small>📅 <%= timeAgo(post.timestamp) %></small>
</div>
      <% }) %>
    </div>
  <% } %>
</main>
<%- include('../partials/footer') %>
