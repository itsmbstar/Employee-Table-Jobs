<%
var extraSchema = '<script type="application/ld+json">' + articleSchema + '<\/script><script type="application/ld+json">' + breadcrumbSchema + '<\/script>';
%>
<%- include('../partials/header') %>
<main class="container section blog-post-container">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a> › <a href="/blog">Blog</a> › <%= post.title.substring(0,40) %><%= post.title.length>40?'…':'' %>
  </nav>
  <article itemscope itemtype="https://schema.org/BlogPosting" class="blog-post-article">
    <% if(post.coverImage){ %><img src="<%= post.coverImage %>" alt="<%= post.title %>" class="blog-post-cover" itemprop="image" width="800" height="400" loading="eager"><% } %>
    <h1 itemprop="headline" class="blog-post-title"><%= post.title %></h1>
    <div class="blog-post-meta">
      <time itemprop="datePublished" datetime="<%= new Date(post.timestamp).toISOString() %>">📅 <%= timeAgo(post.timestamp) %></time>
      <span itemprop="author" itemscope itemtype="https://schema.org/Organization">🏢 <span itemprop="name">Employee Table</span></span>
      <span>👁 <%= views %> views</span>
      <% if(post.tags){ %><span>🏷 <%= post.tags %></span><% } %>
    </div>
    <div class="blog-post-content" itemprop="articleBody"><%- post.content %></div>
    <div class="share-row">
      <span>Share:</span>
      <a href="https://wa.me/?text=<%= encodeURIComponent(post.title+' '+domain+'/blog/'+post.slug) %>" target="_blank" rel="noopener" class="btn btn-whatsapp btn-sm">💬 WhatsApp</a>
      <a href="https://www.linkedin.com/sharing/share-offsite/?url=<%= encodeURIComponent(domain+'/blog/'+post.slug) %>" target="_blank" rel="noopener" class="btn btn-outline btn-sm">in LinkedIn</a>
      <button onclick="navigator.clipboard.writeText(window.location.href).then(()=>{this.textContent='✅ Copied!';setTimeout(()=>this.textContent='🔗 Copy Link',2000)})" class="btn btn-outline btn-sm">🔗 Copy Link</button>
    </div>
  </article>

  <!-- ── ✅ SEO FIX: CURRENT WALK‑IN DRIVES FOR THIS CITY ──────────────── -->
  <% 
    // Detect city from post tags
    var city = '';
    if (post.tags) {
      var tagsLower = post.tags.toLowerCase();
      if (tagsLower.includes('mumbai')) city = 'Mumbai';
      else if (tagsLower.includes('hyderabad')) city = 'Hyderabad';
      else if (tagsLower.includes('bangalore')) city = 'Bangalore';
      else if (tagsLower.includes('delhi')) city = 'Delhi';
      else if (tagsLower.includes('pune')) city = 'Pune';
      else if (tagsLower.includes('chennai')) city = 'Chennai';
      else if (tagsLower.includes('noida')) city = 'Noida';
    }
    if (city && typeof walkins !== 'undefined') {
      var cityWalkins = walkins.filter(w => w.city === city && !w.expired).slice(0, 5);
    }
  %>
  <% if (city && cityWalkins && cityWalkins.length > 0) { %>
    <section class="container section" style="padding: 1.5rem 0; border-top: 1px solid #e5e7eb; margin-top: 2rem;">
      <h3>Current Walk‑In Drives in <%= city %></h3>
      <ul style="list-style: none; padding: 0;">
        <% cityWalkins.forEach(function(w) { %>
          <li style="margin-bottom: 0.5rem;">
            <a href="/walkins/<%= w.slug %>" style="font-weight: 500;"><%= w.companyName %> — <%= w.roleTitle %></a>
            <span style="font-size: 0.9rem; color: #666; display: block;"><%= w.venueAddress %></span>
          </li>
        <% }); %>
      </ul>
      <a href="/walkins?city=<%= encodeURIComponent(city) %>" class="btn btn-outline btn-sm">View all <%= city %> walk‑ins →</a>
    </section>
  <% } %>

  <div class="blog-cta">
    <h2>Looking for verified jobs?</h2>
    <p>Browse 100% free, manually verified job listings across India. Updated daily.</p>
    <a href="/" class="btn btn-primary">Browse Jobs Now →</a>
  </div>

  <% if(related.length>0){ %>
    <section class="related-posts">
      <h2>More from the Blog</h2>
      <div class="blog-grid blog-grid-sm">
        <% related.forEach(p=>{ %>
          <article class="blog-card">
            <div class="blog-card-body">
              <a href="/blog/<%= p.slug %>"><h3><%= p.title %></h3></a>
              <p class="text-muted"><%= timeAgo(p.timestamp) %></p>
            </div>
          </article>
        <% }) %>
      </div>
    </section>
    <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How to verify if a job offer is real?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Check company domain, HR email, Google the company, and never pay fees."
      }
    }
  ]
}
</script>
  <% } %>
</main>
<%- include('../partials/footer') %>