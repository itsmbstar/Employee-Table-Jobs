<%- include('partials/header') %>
<section class="hero hero-sm">
  <div class="container hero-inner">
    <div class="city-hero-emoji"><%= cityInfo.emoji %></div>
    <h1><%= h1 %></h1>
    <p class="hero-sub"><%= jobs.length>0?jobs.length+'+':'Latest' %> free verified jobs in <%= cityInfo.name %> — <%= cityInfo.industries %>. Updated daily.</p>
  </div>
</section>

<main class="container section">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a> › <a href="/">Jobs</a> › Jobs in <%= cityInfo.name %>
  </nav>
  <div class="city-intro">
    <h2>About Jobs in <%= cityInfo.name %></h2>
    <p><%= cityInfo.about %> Employee Table manually verifies every listing before publishing — free to apply, no fees ever.</p>
    <% if(jobs.length>0){ %>
      <p>Currently showing <strong><%= jobs.length %> verified <%= jobs.length===1?'job':'jobs' %></strong> in <%= cityInfo.name %>. New listings added daily — <a href="/#subscribe">subscribe to free alerts</a> to never miss one.</p>
    <% } %>
  </div>
  <div class="section-header">
    <h2>Verified Jobs in <%= cityInfo.name %></h2>
    <span class="job-count-badge"><%= jobs.length %> listing<%= jobs.length!==1?'s':'' %></span>
  </div>
  <% if(jobs.length===0){ %>
    <div class="empty-state">
      <p>No jobs currently listed for <%= cityInfo.name %>.</p>
      <div style="display:flex;gap:.75rem;margin-top:1.25rem;flex-wrap:wrap;justify-content:center">
        <a href="/" class="btn btn-primary">Browse All Jobs</a>
        <a href="/#subscribe" class="btn btn-outline">🔔 Get Alerts</a>
      </div>
    </div>
  <% }else{ %>
    <div class="jobs-grid">
      <% jobs.forEach(job=>{ %><%- include('partials/job-card',{job}) %><% }) %>
    </div>
  <% } %>
</main>

<section class="section bg-light">
  <div class="container">
    <h2>Jobs in Other Cities</h2>
    <div class="city-pills">
      <% cities.filter(c=>c.slug!==cityInfo.slug).forEach(c=>{ %>
        <a href="/jobs-in-<%= c.slug %>" class="city-pill"><%= c.emoji %> <%= c.name %></a>
      <% }) %>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
