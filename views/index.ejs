<%- include('partials/header') %>
<!-- Organization Schema -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Employee Table",
  "url": "https://www.employeetable.in",
  "logo": "https://www.employeetable.in/img/logo.png",
  "description": "India's leading verified job portal with 5000+ free job listings for freshers and professionals.",
  "foundingDate": "2021",
  "founders": [{"@type": "Person", "name": "Employee Table Team"}],
  "address": {"@type": "Country", "name": "India"}
}
</script>

<!-- Website Schema -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Employee Table",
  "url": "https://www.employeetable.in",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://www.employeetable.in/?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
}
</script>
<section class="hero">
  <div class="container hero-inner">
    <h1 class="hero-title">Find Verified Jobs in India — Free for Freshers &amp; Professionals</h1>
    <p class="hero-sub">Every listing manually verified. No scams. No fees. Updated daily since 2021. Jobs in Mumbai, Bangalore, Delhi, Pune, Hyderabad &amp; more.</p>
    <div class="hero-badges">
      <span>✅ 100% Free</span>
      <span>✅ Manually Verified</span>
      <span>✅ Fresher Friendly</span>
      <span>✅ Daily Updates</span>
      <span>✅ Remote &amp; On-site</span>
    </div>
    <a href="#jobs" class="btn btn-white">Browse Jobs Now</a>
  </div>
</section>

<section class="search-section">
  <div class="container">
    <h2 class="section-label">Search Verified Jobs</h2>
    <form class="search-form" method="GET" action="/" role="search">
      <input type="search" name="q" value="<%= filters.q %>" placeholder="Job title, company, skill…" class="search-input" aria-label="Search jobs">
      <select name="city" class="search-select" aria-label="Filter by city">
        <option value="">All Cities</option>
        <% cities.forEach(c=>{ %><option value="<%= c.name %>" <%= filters.city===c.name?'selected':'' %>><%= c.name %></option><% }) %>
      </select>
      <select name="exp" class="search-select" aria-label="Filter by experience">
        <option value="">All Experience</option>
        <option value="Fresher"     <%= filters.exp==='Fresher'?    'selected':'' %>>Fresher (0–1 yr)</option>
        <option value="Experienced" <%= filters.exp==='Experienced'?'selected':'' %>>Experienced (2+ yrs)</option>
      </select>
      <select name="dateRange" class="search-select" aria-label="Filter by date posted">
        <option value="">Any Time</option>
        <option value="1" <%= filters.dateRange==='1'?'selected':'' %>>Last 24 Hours</option>
        <option value="3" <%= filters.dateRange==='3'?'selected':'' %>>Last 3 Days</option>
        <option value="7" <%= filters.dateRange==='7'?'selected':'' %>>Last Week</option>
      </select>
      <button type="submit" class="btn btn-primary">🔍 Search</button>
      <% if(filters.q||filters.city||filters.exp||filters.dateRange){ %>
        <a href="/" class="btn btn-outline">Clear</a>
      <% } %>
    </form>
  </div>
</section>

<section class="stats-bar">
  <div class="container stats-grid">
    <div class="stat"><span class="stat-val">5,000+</span><span class="stat-label">Jobs Posted</span></div>
    <div class="stat"><span class="stat-val">100%</span><span class="stat-label">Verified</span></div>
    <div class="stat"><span class="stat-val">50,000+</span><span class="stat-label">Helped</span></div>
    <div class="stat"><span class="stat-val">Since 2021</span><span class="stat-label">Trusted</span></div>
  </div>
</section>

<main class="container section" id="jobs">
  <div class="section-header">
    <h2>Latest Verified Jobs</h2>
    <span class="job-count-badge"><%= totalFiltered %> job<%= totalFiltered!==1?'s':'' %> found</span>
  </div>
  <% if(jobs.length===0){ %>
    <div class="empty-state">
      <p>No jobs match your search. Try broader keywords or <a href="/">clear filters</a>.</p>
    </div>
  <% }else{ %>
    <div class="jobs-grid">
      <% jobs.forEach(job=>{ %><%- include('partials/job-card',{job}) %><% }) %>
    </div>
    <% if(totalPages>1){ %>
      <nav class="pagination" aria-label="Job listings pagination">
        <% if(currentPage>1){ %><a href="/<%= buildQuery(currentPage-1) %>" class="page-btn">← Prev</a><% }else{ %><span class="page-btn page-btn-disabled">← Prev</span><% } %>
        <% for(let p=1;p<=totalPages;p++){ %>
          <% if(p===currentPage){ %><span class="page-btn page-btn-active" aria-current="page"><%= p %></span>
          <% }else if(p===1||p===totalPages||Math.abs(p-currentPage)<=2){ %><a href="/<%= buildQuery(p) %>" class="page-btn"><%= p %></a>
          <% }else if(Math.abs(p-currentPage)===3){ %><span class="page-btn page-btn-dots">…</span><% } %>
        <% } %>
        <% if(currentPage<totalPages){ %><a href="/<%= buildQuery(currentPage+1) %>" class="page-btn">Next →</a><% }else{ %><span class="page-btn page-btn-disabled">Next →</span><% } %>
      </nav>
    <% } %>
  <% } %>
</main>



<section class="section walkin-home-section" id="walkins-home">
  <div class="container">
    <div class="section-header">
      <div>
        <h2 class="walkin-home-heading">Walk-in Interviews</h2>
        <p class="walkin-home-sub">No application forms. Just walk in, interview, get hired.</p>
      </div>
      <a href="/walkins" class="btn btn-outline btn-sm" aria-label="View all walk-in drives">View All →</a>
    </div>

    <% if (todayWalkins && todayWalkins.length > 0) { %>
    <div class="walkin-home-grid">
      <% todayWalkins.forEach(function(w) {
        var _now = Date.now();
        var _start = w.interviewDateStart || w.timestamp || _now;
        var _end   = w.interviewDateEnd   || _start;
        var _todayMS = new Date(new Date().getFullYear(), new Date().getMonth(), new Date().getDate()).getTime();
        var _tomorrowMS = _todayMS + 86400000;
        var _isExpired  = _now > _end;
        var _isToday    = !_isExpired && _start >= _todayMS && _start < _tomorrowMS;
        var _isTomorrow = !_isExpired && !_isToday && _start >= _tomorrowMS && _start < _tomorrowMS + 86400000;
        var _daysLeft   = Math.ceil((_start - _now) / 86400000);
        var _startDate  = new Date(_start);
        var _dayNum     = _startDate.getDate();
        var _monthStr   = _startDate.toLocaleDateString('en-IN', { month: 'short' });
      %>
      <article class="wk-home-card<% if(_isToday){ %> wk-home-card--today<% } %>">
        <div class="wk-home-card__date wk-date--<%= _isToday ? 'today' : (_isExpired ? 'expired' : 'upcoming') %>">
          <span class="wk-date__day"><%= _dayNum %></span>
          <span class="wk-date__month"><%= _monthStr %></span>
          <% if (_isToday) { %><span class="wk-badge wk-badge--today">TODAY</span><% } else if (_isTomorrow) { %><span class="wk-badge wk-badge--soon">SOON</span><% } else if (!_isExpired) { %><span class="wk-badge wk-badge--upcoming">In <%= _daysLeft %>d</span><% } %>
        </div>
        <div class="wk-home-card__body">
          <div class="wk-home-card__top">
            <div>
              <h3 class="wk-home-card__role">
                <a href="/walkins/<%= w.slug %>" aria-label="View <%= w.roleTitle %> walk-in at <%= w.companyName %>">
                  <%= w.roleTitle %>
                </a>
              </h3>
              <p class="wk-home-card__company">
                <%= w.companyName %>
                <% if (w.verified) { %><span class="wk-verified" title="Verified">✅</span><% } %>
              </p>
            </div>
          </div>
          <div class="wk-home-card__meta">
            <span>📍 <%= w.city %><% if(w.area){ %>, <%= w.area %><% } %></span>
            <span>⏰ <%= w.interviewTime || '10 AM – 5 PM' %></span>
            <span>🎓 <%= w.eligibility || 'Any Graduate' %></span>
            <% if (w.package) { %><span>💰 <%= w.package %></span><% } %>
          </div>
          <div class="wk-home-card__actions">
            <a href="/walkins/<%= w.slug %>" class="btn btn-outline btn-sm" aria-label="View details for <%= w.companyName %> walk-in">View Details</a>
            <% if (w.hrContactPhone) { %>
              <a href="https://wa.me/<%= w.hrContactPhone.replace(/\D/g,'') %>" target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp btn-sm" aria-label="WhatsApp HR for <%= w.companyName %>">💬 WhatsApp HR</a>
            <% } %>
          </div>
        </div>
      </article>
      <% }) %>
    </div>
    <div class="walkin-home-footer">
      <a href="/walkins" class="btn btn-primary" aria-label="Browse all verified walk-in interviews in India">
        Browse All Walk-In Drives →
      </a>
    </div>
    <% } else { %>
    <div class="walkin-home-empty">
      <p>🗓️ No walk-in drives right now. New drives are added daily.</p>
      <a href="/walkins" class="btn btn-outline btn-sm">Check back soon →</a>
    </div>
    <% } %>
  </div>
</section>

<section class="subscribe-section" id="subscribe">
  <div class="container subscribe-inner">
    <h2>Never Miss a Job — Get Free Alerts</h2>
    <p>Verified job openings delivered to your inbox every morning. Free forever.</p>
    <form class="subscribe-form" id="subForm">
      <input type="text"  id="sub-name"  placeholder="Your name"    required class="sub-input" autocomplete="name">
      <input type="email" id="sub-email" placeholder="Email address" required class="sub-input" autocomplete="email">
      <select id="sub-city" class="sub-input" aria-label="Preferred city">
        <option value="">Any City</option>
        <% cities.forEach(c=>{ %><option value="<%= c.name %>"><%= c.name %></option><% }) %>
      </select>
      <button type="submit" class="btn btn-white">🔔 Subscribe Free</button>
    </form>
    <p id="sub-msg" class="sub-msg hidden"></p>
    <p class="sub-note">🔒 No spam. Unsubscribe anytime.</p>
  </div>
</section>

<section class="section" id="why">
  <div class="container">
    <h2 class="text-center">Why Job Seekers Choose Employee Table</h2>
    <div class="why-grid">
      <div class="why-card"><div class="why-icon">🛡️</div><h3>100% Verified Listings</h3><p>Every job is manually checked before it goes live. No ghost postings, no scam links.</p></div>
      <div class="why-card"><div class="why-icon">💚</div><h3>Always Free for Candidates</h3><p>No premium plans, no hidden fees. Free for all job seekers, always.</p></div>
      <div class="why-card"><div class="why-icon">🎓</div><h3>Built for Freshers First</h3><p>We focus on 0–2 year experience roles, off-campus drives, and internships.</p></div>
    </div>
  </div>
</section>

<section class="section bg-light" id="about">
  <div class="container text-center">
    <h2>About Employee Table</h2>
    <p class="about-text">Employee Table specializes in providing <strong>verified job updates</strong> completely <strong>free of cost</strong>, with a special focus on freshers entering the job market. Since 2021, we've helped thousands of candidates find legitimate opportunities by manually verifying each listing. No hidden fees, no scams — just real verified opportunities across India.</p>
  </div>
</section>

<script type="application/ld+json">
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Is Employee Table free for job seekers?","acceptedAnswer":{"@type":"Answer","text":"Yes, 100% free. We never charge candidates fees to browse or apply."}},{"@type":"Question","name":"How are jobs verified?","acceptedAnswer":{"@type":"Answer","text":"Every listing is manually reviewed — company, role, and apply link verified before publishing."}},{"@type":"Question","name":"Does Employee Table have fresher jobs?","acceptedAnswer":{"@type":"Answer","text":"Yes, we specialize in 0-2 year experience roles, internships, and off-campus drives across India."}}]}
</script>
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"WebSite","name":"Employee Table","url":"<%= domain %>/","potentialAction":{"@type":"SearchAction","target":"<%= domain %>/?q={search_term_string}","query-input":"required name=search_term_string"}}
</script>

<script>
document.getElementById('subForm').addEventListener('submit',async function(e){
  e.preventDefault();
  const btn=this.querySelector('button[type="submit"]');
  btn.disabled=true; btn.textContent='Subscribing…';
  try{
    const r=await fetch('/subscribe',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:new URLSearchParams({name:document.getElementById('sub-name').value,email:document.getElementById('sub-email').value,city:document.getElementById('sub-city').value})});
    const d=await r.json();
    const msg=document.getElementById('sub-msg');
    msg.textContent=d.message; msg.classList.remove('hidden');
    document.querySelector('.subscribe-form').style.display='none';
  }catch(err){btn.disabled=false;btn.textContent='🔔 Subscribe Free';}
});
</script>
<%- include('partials/footer') %>
