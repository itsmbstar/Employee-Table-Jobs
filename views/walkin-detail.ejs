<%- include('partials/header') %>

<!-- ── ✅ SEO FIXES: CANONICAL, OG, TWITTER, HREFLANG, NOINDEX ────────────── -->
<link rel="canonical" href="<%= canonical %>">

<meta property="og:type" content="article">
<meta property="og:title" content="<%= title %>">
<meta property="og:description" content="<%= metaDescription %>">
<meta property="og:url" content="<%= canonical %>">
<meta property="og:image" content="<%= ogImage || 'https://www.employeetable.in/img/og-image.jpg' %>">
<meta property="og:site_name" content="Employee Table">
<meta property="og:locale" content="en_IN">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= title %>">
<meta name="twitter:description" content="<%= metaDescription %>">
<meta name="twitter:image" content="<%= ogImage || 'https://www.employeetable.in/img/og-image.jpg' %>">

<link rel="alternate" hreflang="en-IN" href="<%= canonical %>">

<% if(isExpired) { %>
  <meta name="robots" content="noindex, nofollow">
<% } %>

<main class="container section">

  <!-- ── HTML BREADCRUMB ────────────────────────────────────────────────── -->
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a> › 
    <a href="/walkins">Walk-In Drives</a> › 
    <%= walkin.companyName %> <%= walkin.city %>
  </nav>

  <!-- ── ✅ SEO FIX: H1 FORMAT ─────────────────────────────────────────── -->
  <h1>Walk-In Drive: <%= walkin.companyName %> <%= walkin.city %> — <%= new Date(walkin.interviewDateStart).toLocaleString('en-IN', { month: 'long', year: 'numeric' }) %></h1>

  <% if(isExpired){ %>
    <div class="flash flash-error" style="position:static;margin-bottom:1.5rem">
      ⏳ This walk-in drive has ended. Check <a href="/walkins">active walk-in drives</a> below.
    </div>
  <% } %>

  <article class="job-detail-card">
    <div class="job-card-top">
      <!-- ── ✅ SEO FIX: COMPANY LOGO WITH ALT TEXT & LAZY LOAD ─────────── -->
      <% if(walkin.companyLogo && walkin.companyLogo.startsWith('http')){ %>
        <img src="<%= walkin.companyLogo %>" alt="<%= walkin.companyName %> logo — Walk-In Drive in <%= walkin.city %>" class="company-logo-lg" width="56" height="56" loading="lazy" onerror="this.style.display='none'">
      <% } else { %>
        <div class="company-logo-placeholder" style="width:56px;height:56px;font-size:1.5rem"><%= (walkin.companyName||'C').charAt(0).toUpperCase() %></div>
      <% } %>
      <div class="job-card-title-block">
        <h2 style="margin:0"><%= walkin.roleTitle %></h2>
        <p class="job-company" style="font-size:1.1rem"><%= walkin.companyName %> · <%= walkin.city %><%= walkin.area ? ', '+walkin.area : '' %></p>
      </div>
      <% if(walkin.verified){ %><span class="verified-badge" title="Verified by Employee Table" style="font-size:1.5rem">✅ Verified</span><% } %>
    </div>

    <div class="job-meta" style="margin:1.5rem 0;font-size:1rem">
      <!-- ── ✅ DISPLAY DATE RANGE ──────────────────────────────────────── -->
      <span>🗓️ <strong><%= new Date(walkin.interviewDateStart).toLocaleDateString('en-IN',{day:'numeric',month:'long',year:'numeric'}) %> – <%= new Date(walkin.interviewDateEnd).toLocaleDateString('en-IN',{day:'numeric',month:'long',year:'numeric'}) %></strong></span>
      <span>⏰ <%= walkin.interviewTime %></span>
      <span>🎓 <%= walkin.eligibility %></span>
      <% if(walkin.package){ %><span>💰 <%= walkin.package %></span><% } %>
    </div>

    <div class="job-description">
      <h2>📍 Venue</h2>
      <p><%= walkin.venueAddress %></p>

      <h2>📄 Documents to Carry</h2>
      <p><%= walkin.documentsRequired %></p>

      <h2>🎯 Eligibility</h2>
      <p><%= walkin.eligibility %></p>

      <h2>📞 HR Contact</h2>
      <p>
        <% if(walkin.hrContactPhone){ %>Phone/WhatsApp: <a href="tel:<%= walkin.hrContactPhone %>"><%= walkin.hrContactPhone %></a><br><% } %>
        <% if(walkin.hrContactEmail){ %>Email: <a href="mailto:<%= walkin.hrContactEmail %>"><%= walkin.hrContactEmail %></a><% } %>
      </p>

      <p style="margin-top:1.5rem;padding:1rem;background:#f0fdf4;border-radius:8px;font-size:.9rem;color:#166534">
        ✅ This listing was manually verified by Employee Table before publishing. Always carry original documents and arrive during the stated interview window.
      </p>
      <% if(!isExpired && faqs && faqs.length>0){ %>
        <h2 style="margin-top:2rem">❓ Frequently Asked Questions</h2>
        <div class="walkin-faq">
          <% faqs.forEach(f=>{ %>
            <details class="faq-item" style="margin-bottom:.75rem;border:1px solid #e5e7eb;border-radius:8px;padding:.85rem 1rem">
              <summary style="cursor:pointer;font-weight:600"><%= f.q %></summary>
              <p style="margin-top:.6rem;color:#444"><%= f.a %></p>
            </details>
          <% }) %>
        </div>
      <% } %>
      
    </div>

    <div class="job-actions" style="margin-top:1.5rem">
      <% if(walkin.hrContactPhone){ %>
        <a href="tel:<%= walkin.hrContactPhone %>" class="btn btn-call" onclick="fetch('/walkins/<%= walkin.slug %>/click',{method:'POST'})">📞 Call HR Now</a>
      <% } %>
      <% if(walkin.hrContactEmail){ %>
        <a href="mailto:<%= walkin.hrContactEmail %>?subject=<%= encodeURIComponent('Application for '+walkin.roleTitle+' - Walk-In Drive') %>" class="btn btn-primary">✉️ Email HR</a>
      <% } %>
      <a href="/walkins" class="btn btn-outline">← All Walk-Ins</a>
    </div>
  </article>

  <% if(related && related.length>0){ %>
    <div class="section-header" style="margin-top:2.5rem">
      <h2>Other Walk-Ins in <%= walkin.city %></h2>
    </div>
    <div class="jobs-grid">
      <% related.forEach(w=>{ %><%- include('partials/walkin-card',{walkin:w}) %><% }) %>
    </div>
  <% } %>
</main>

<!-- ── ✅ SEO FIX: BREADCRUMBLIST SCHEMA ────────────────────────────────── -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.employeetable.in/" },
    { "@type": "ListItem", "position": 2, "name": "Walk-In Drives", "item": "https://www.employeetable.in/walkins" },
    { "@type": "ListItem", "position": 3, "name": "<%= walkin.companyName %> <%= walkin.city %>", "item": "<%= canonical %>" }
  ]
}
</script>

<%- include('partials/footer') %>